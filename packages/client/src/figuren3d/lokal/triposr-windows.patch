 import torch.nn as nn
-from torchmcubes import marching_cubes
+import mcubes
+
+
+def marching_cubes(level, threshold):
+    # Ersatz fuer torchmcubes (braucht unter Windows einen CUDA-Compiler).
+    # PyMCubes liefert die Ecken in Achsreihenfolge (i, j, k); torchmcubes
+    # liefert (k, j, i), deshalb wird unten zurueckgetauscht, damit der
+    # Rest des Codes unveraendert bleibt.
+    v, f = mcubes.marching_cubes(level.cpu().numpy(), threshold)
+    v = torch.from_numpy(v[:, [2, 1, 0]].astype(np.float32))
+    f = torch.from_numpy(f.astype(np.int64))
+    return v, f
 
 
