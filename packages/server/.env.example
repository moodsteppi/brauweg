# Lokal ohne Installation: startet PostgreSQL als WebAssembly im Prozess.
DATABASE_URL=pglite

# Supabase: "Connect" im Dashboard, Methode "Session pooler" (Port 5432).
# Der Transaction Pooler auf 6543 ist fuer Serverless gedacht und
# unterstuetzt keine Prepared Statements - dieser Server braucht Session Mode.
# DATABASE_URL=postgresql://postgres.<projekt>:<passwort>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Basis fuer Links in E-Mails. Bestimmt ausserdem, ob das Sitzungs-Cookie
# secure gesetzt wird: https ja, http nein.
PUBLIC_URL=http://localhost:5173

# Ohne Schluessel werden Mails nur ins Log geschrieben, statt verworfen.
# Einrichtung: docs/RESEND.md (Domain bei Resend, DNS bei Strato, Key hier).
# RESEND_API_KEY=
MAIL_FROM=Brauweg <noreply@brauweg-spielen.de>

SESSION_TTL_DAYS=30
PORT=3000

# Nur Entwicklung: legt diesen Einladungscode beim Start an.
INVITE_CODE=BRAUWEG-BETA

# Produktion: Migrationen beim Start anwenden.
# MIGRATE_ON_BOOT=true

# Was diese Ausgabe anbietet (src/umfang.ts, docs/APP-RELEASE.md). Nicht
# gesetzt = alles an, wie auf staging. Sonst nur die genannten Spiele und
# Funktionen - fuer Webseite und App, vom Server auch gesperrt.
# UMFANG=doppelkopf,skat,filler,brochess,kartenmanufaktur,browort,clanwort,lernpfad,abstimmung,mehrkampf,schafkopf,romme,maumau,schwimmen,backgammon,bauernskat,phase10,drecksau

# Nur staging: Webseite fragt nach Name und Passwort (src/http/zugangsschutz.ts).
# App, /api/health und /.well-known bleiben frei. Nicht gesetzt = offen.
# STAGING_ZUGANG=team:ein-langes-passwort
