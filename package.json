{
  "name": "brauweg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Brauweg - Kartenspiel-Plattform mit frei konfigurierbaren Regelsaetzen",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:server": "npm run build --workspace @brauweg/server && node packages/server/dist/src/index.js",
    "dev:client": "npm run dev --workspace @brauweg/client",
    "test": "npm test --workspaces --if-present"
  }
}

