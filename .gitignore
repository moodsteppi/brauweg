node_modules/
dist/
*.tsbuildinfo

.env
.env.*
!.env.example

.DS_Store
Thumbs.db

coverage/
*.log

# Eingebettete Entwicklungsdatenbank
.pglite/

# Uebergabe-Archive, Inhalt liegt entpackt im Repository
/files.zip
/plattform-uebergabe.zip

# Arbeitsordner der Bildaufbereitung — nichts davon gehoert ins Repository.
tmp-*/

# Geholte Feldherr-Mitschnitte (docs/FELDHERR-DIAGNOSE.md).
#
# Sie entstehen auf dem Entwicklungsrechner, wenn diagnose-holen.mjs sie vom
# Produktivsystem holt, und beschreiben echte Partien echter Spieler samt
# ihrer Geraete. Das gehoert in kein Repository — gebraucht wird es fuer die
# Dauer einer Fehlersuche.
/diagnose/

# Bildquellen in voller Aufloesung liegen im Archivrepo moodsteppi/brauweg-art.
#
# Sie sind zusammen ueber 800 MB und wurden hier bei jedem Deploy mitgeladen,
# obwohl weder der Build noch ein Nutzer sie je anfasst. Ausgeliefert wird
# ausschliesslich die WebP-Fassung unter packages/client/public/.
packages/client/art/

# Sicherung unverfolgter Dateien, die der Worker vor einer Aufgabe anlegt.
# Sie gehoert auf die Platte des jeweiligen Rechners, nicht ins Repo: Sie
# traegt fremde Benutzerpfade und schachtelt sich bei jedem Lauf in sich
# selbst (gemessen am 05.09.2026: vier Dateien, 700 Zeilen, eine enthielt
# die andere).
altlasten/

# Android-Huelle (apps/android): Bauergebnisse, der eingespielte Client und
# vor allem die Signierschluessel. Ein Upload-Schluessel im Repo ist ein
# Schluessel fuer jeden, der das Repo sieht (docs/APP-RELEASE.md).
apps/android/.gradle/
apps/android/build/
apps/android/app/build/
apps/android/local.properties
apps/android/app/src/main/assets/web/
apps/android/keystore.properties
# Werte des Firebase-Projekts fuer den Push-Schalter (-Ppush=an). Nicht
# geheim wie ein Schluessel, aber an ein Konto gebunden, das es noch nicht gibt.
apps/android/firebase.properties
*.jks
*.keystore
# iOS-Bauskript: lokale Angaben (Team-ID, Schluessel-IDs) bleiben auf dem Mac.
werkzeug/app/ios-lokal.env
werkzeug/app/ios-bau/
*.p8
