# Vorlage fuer werkzeug/app/ios-lokal.env — kopieren, ausfuellen, NICHT einchecken.
# Nichts hiervon ist ein Geheimnis im engen Sinn, aber alles haengt an Toms
# Apple-Konto und gehoert deshalb auf seinen Mac, nicht ins Repo.

# developer.apple.com → Account → Membership details → Team ID (10 Zeichen)
TEAM_ID=
# App Store Connect → Users and Access → Integrations → App Store Connect API
# → Team Keys: "Key ID" und oben "Issuer ID". Rolle des Schluessels: Admin
# (App Manager reicht nur, wenn er Zugriff auf "Certificates, Identifiers &
# Profiles" und die Cloud-Signierung hat — sonst scheitert der Export).
# Die .p8-Datei liegt unter ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8
ASC_KEY_ID=
ASC_ISSUER_ID=

# Wahlweise — ohne Angabe gilt apps/ios/project.yml (Release: Produktion, Push aus).
# API_BASE=https://staging.brauweg-spielen.de
# PUSH=YES
# Scheme und Konfiguration (Vorgabe: Brauweg, Release)
# SCHEME=Brauweg
# KONFIGURATION=Release
