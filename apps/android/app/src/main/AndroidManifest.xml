<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- navigator.vibrate am Tisch ("du bist dran", Poker-Regler). Ohne die
         Erlaubnis schweigt der WebView stumm. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Ob ueberhaupt ein Netz da ist: fuer die Meldung ohne Netz
         (MainActivity) und damit navigator.onLine im WebView stimmt — ohne
         die Erlaubnis meldet der WebView nie offline. Eine Normal-Erlaubnis,
         der Nutzer wird nicht gefragt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      allowBackup=false: Im App-Speicher liegt das Sitzungstoken
      (laufzeit.ts, localStorage). Eine Cloud-Sicherung nimmt es sonst mit
      auf ein anderes Geraet — und ins Google-Konto des Nutzers.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/keine_sicherung"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Brauweg">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|density">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              App Links fuer den Einladungslink (#203). autoVerify: Android
              prueft beim Installieren /.well-known/assetlinks.json auf dem
              Server (packages/server/src/http/app-verknuepfung.ts). Stimmt
              der Fingerabdruck, oeffnet der Link direkt die App statt der
              Webseite; sonst bleibt es bei der Webseite, und nichts geht
              kaputt.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="www.brauweg-spielen.de"
                    android:pathPrefix="/beitritt/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
