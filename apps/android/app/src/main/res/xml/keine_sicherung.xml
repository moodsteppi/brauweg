<?xml version="1.0" encoding="utf-8"?>
<!-- Ab Android 12: weder Cloud-Sicherung noch Umzug auf ein neues Geraet.
     Grund wie bei allowBackup im Manifest: das Sitzungstoken. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
